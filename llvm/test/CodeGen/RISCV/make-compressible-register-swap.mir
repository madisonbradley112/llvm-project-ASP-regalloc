# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=riscv64 -mattr=+c -run-pass=riscv-make-compressible-register-swap \
# RUN:     -verify-machineinstrs %s -o - | FileCheck %s

# Compression-aware live range splitting at call boundaries. The pass copies a
# value that is live across a call into a fresh GPRC-constrained vreg and
# rewrites the uses that copy dominates, so the allocator is forced to keep the
# value in x8-x15 and the later instructions stay 16-bit.
#
# @split_basic also covers the last-use boundary: the parent dies at the fourth
# load, so liveness there must be queried at the use slot rather than the
# register slot. Asking at the register slot lands exactly on the half-open end
# of the live range, returns null, and silently drops the final use of every
# candidate. All four loads must be rewritten.

--- |
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "riscv64"

  declare void @h()

  ; Four compressible LW uses after the call: benefit clears the threshold.
  define i32 @split_basic(ptr %p) optsize { ret i32 0 }

  ; Only one use after the call: one c.mv cannot pay for itself.
  define i32 @reject_single_use(ptr %p) optsize { ret i32 0 }

  ; All uses sit in one dominated successor, so the copy sinks out of the
  ; call block and off the path that does not use it.
  define i32 @sink_to_successor(ptr %p, i32 %c) optsize { ret i32 0 }

  ; Same shape as @split_basic but without optsize: this is a size
  ; optimization only, so the pass must leave the function alone.
  define i32 @no_optsize(ptr %p) { ret i32 0 }
...
---
name:            split_basic
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
  - { id: 3, class: gpr }
  - { id: 4, class: gpr }
  - { id: 5, class: gpr }
  - { id: 6, class: gpr }
  - { id: 7, class: gpr }
liveins:
  - { reg: '$x10', virtual-reg: '%0' }
frameInfo:
  adjustsStack:    true
  hasCalls:        true
body:             |
  bb.0:
    liveins: $x10

    ; CHECK-LABEL: name: split_basic
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $x10
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: PseudoCALL target-flags(riscv-call) @h, csr_ilp32d_lp64d, implicit-def dead $x1, implicit-def $x2
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gprc = COPY [[COPY]]
    ; CHECK-NEXT: [[LW:%[0-9]+]]:gpr = LW [[COPY1]], 0
    ; CHECK-NEXT: [[LW1:%[0-9]+]]:gpr = LW [[COPY1]], 4
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:gpr = ADD [[LW1]], [[LW]]
    ; CHECK-NEXT: [[LW2:%[0-9]+]]:gpr = LW [[COPY1]], 8
    ; CHECK-NEXT: [[ADD1:%[0-9]+]]:gpr = ADD [[ADD]], [[LW2]]
    ; CHECK-NEXT: [[LW3:%[0-9]+]]:gpr = LW [[COPY1]], 12
    ; CHECK-NEXT: [[ADDW:%[0-9]+]]:gpr = ADDW [[ADD1]], [[LW3]]
    ; CHECK-NEXT: $x10 = COPY [[ADDW]]
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:gpr = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @h, csr_ilp32d_lp64d, implicit-def dead $x1, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %1:gpr = LW %0, 0
    %2:gpr = LW %0, 4
    %3:gpr = ADD %2, %1
    %4:gpr = LW %0, 8
    %5:gpr = ADD %3, %4
    %6:gpr = LW %0, 12
    %7:gpr = ADDW %5, %6
    $x10 = COPY %7
    PseudoRET implicit $x10

...
---
name:            reject_single_use
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
liveins:
  - { reg: '$x10', virtual-reg: '%0' }
frameInfo:
  adjustsStack:    true
  hasCalls:        true
body:             |
  bb.0:
    liveins: $x10

    ; CHECK-LABEL: name: reject_single_use
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $x10
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: PseudoCALL target-flags(riscv-call) @h, csr_ilp32d_lp64d, implicit-def dead $x1, implicit-def $x2
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: [[LW:%[0-9]+]]:gpr = LW [[COPY]], 0
    ; CHECK-NEXT: $x10 = COPY [[LW]]
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:gpr = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @h, csr_ilp32d_lp64d, implicit-def dead $x1, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %1:gpr = LW %0, 0
    $x10 = COPY %1
    PseudoRET implicit $x10

...
---
name:            sink_to_successor
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
  - { id: 3, class: gpr }
  - { id: 4, class: gpr }
  - { id: 5, class: gpr }
  - { id: 6, class: gpr }
  - { id: 7, class: gpr }
  - { id: 8, class: gpr }
liveins:
  - { reg: '$x10', virtual-reg: '%0' }
  - { reg: '$x11', virtual-reg: '%1' }
frameInfo:
  adjustsStack:    true
  hasCalls:        true
body:             |
  ; CHECK-LABEL: name: sink_to_successor
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $x11
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr = COPY $x10
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @h, csr_ilp32d_lp64d, implicit-def dead $x1, implicit-def $x2
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   BNE [[COPY]], $x0, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr = COPY $x0
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gprc = COPY [[COPY1]]
  ; CHECK-NEXT:   [[LW:%[0-9]+]]:gpr = LW [[COPY3]], 0
  ; CHECK-NEXT:   [[LW1:%[0-9]+]]:gpr = LW [[COPY3]], 4
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:gpr = ADD [[LW1]], [[LW]]
  ; CHECK-NEXT:   [[LW2:%[0-9]+]]:gpr = LW [[COPY3]], 8
  ; CHECK-NEXT:   [[ADD1:%[0-9]+]]:gpr = ADD [[ADD]], [[LW2]]
  ; CHECK-NEXT:   [[LW3:%[0-9]+]]:gpr = LW [[COPY3]], 12
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr = ADDW [[ADD1]], [[LW3]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   $x10 = COPY [[COPY2]]
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $x10, $x11

    %1:gpr = COPY $x11
    %0:gpr = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @h, csr_ilp32d_lp64d, implicit-def dead $x1, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    BNE %1, $x0, %bb.2

  bb.1:
    successors: %bb.3(0x80000000)

    %8:gpr = COPY $x0
    PseudoBR %bb.3

  bb.2:
    successors: %bb.3(0x80000000)

    %2:gpr = LW %0, 0
    %3:gpr = LW %0, 4
    %4:gpr = ADD %3, %2
    %5:gpr = LW %0, 8
    %6:gpr = ADD %4, %5
    %7:gpr = LW %0, 12
    %8:gpr = ADDW %6, %7

  bb.3:
    $x10 = COPY %8
    PseudoRET implicit $x10

...
---
name:            no_optsize
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
  - { id: 3, class: gpr }
  - { id: 4, class: gpr }
  - { id: 5, class: gpr }
  - { id: 6, class: gpr }
  - { id: 7, class: gpr }
liveins:
  - { reg: '$x10', virtual-reg: '%0' }
frameInfo:
  adjustsStack:    true
  hasCalls:        true
body:             |
  bb.0:
    liveins: $x10

    ; CHECK-LABEL: name: no_optsize
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $x10
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: PseudoCALL target-flags(riscv-call) @h, csr_ilp32d_lp64d, implicit-def dead $x1, implicit-def $x2
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: [[LW:%[0-9]+]]:gpr = LW [[COPY]], 0
    ; CHECK-NEXT: [[LW1:%[0-9]+]]:gpr = LW [[COPY]], 4
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:gpr = ADD [[LW1]], [[LW]]
    ; CHECK-NEXT: [[LW2:%[0-9]+]]:gpr = LW [[COPY]], 8
    ; CHECK-NEXT: [[ADD1:%[0-9]+]]:gpr = ADD [[ADD]], [[LW2]]
    ; CHECK-NEXT: [[LW3:%[0-9]+]]:gpr = LW [[COPY]], 12
    ; CHECK-NEXT: [[ADDW:%[0-9]+]]:gpr = ADDW [[ADD1]], [[LW3]]
    ; CHECK-NEXT: $x10 = COPY [[ADDW]]
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:gpr = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @h, csr_ilp32d_lp64d, implicit-def dead $x1, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %1:gpr = LW %0, 0
    %2:gpr = LW %0, 4
    %3:gpr = ADD %2, %1
    %4:gpr = LW %0, 8
    %5:gpr = ADD %3, %4
    %6:gpr = LW %0, 12
    %7:gpr = ADDW %5, %6
    $x10 = COPY %7
    PseudoRET implicit $x10

...
